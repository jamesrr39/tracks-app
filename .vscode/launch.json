    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Tracks App",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tracks-app-main.go",
            "args": ["serve", "localenv/data", "--pmtiles-file-path=localenv/map/pmtiles/v3.pmtiles"],
            "env": {
                "LOCAL_DEV_SERVER_URL": "http://localhost:5173"
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}